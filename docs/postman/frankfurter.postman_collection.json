{
  "info": {
    "name": "Frankfurter API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://api.frankfurter.dev/v1"
    }
  ],
  "item": [
    {
      "name": "Listar moedas",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200',()=>pm.response.to.have.status(200));",
              "pm.test('tem USD',()=>pm.expect(pm.response.json()).to.have.property('USD'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/currencies"
        }
      }
    },
    {
      "name": "Última cotação EUR→USD (exemplo do enunciado)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200',()=>pm.response.to.have.status(200));",
              "pm.test('base EUR e taxa USD numérica',()=>{const j=pm.response.json();pm.expect(j.base).to.eql('EUR');pm.expect(j.rates.USD).to.be.a('number');});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/latest?base=EUR&symbols=USD"
        }
      }
    },
    {
      "name": "Última cotação USD→BRL",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200',()=>pm.response.to.have.status(200));",
              "pm.test('taxa numérica',()=>pm.expect(pm.response.json().rates.BRL).to.be.a('number'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/latest?base=USD&symbols=BRL"
        }
      }
    },
    {
      "name": "Série 2024-01",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200',()=>pm.response.to.have.status(200));",
              "pm.test('tem datas',()=>pm.expect(Object.keys(pm.response.json().rates).length).to.be.above(0));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/2024-01-01..2024-01-31?base=USD&symbols=BRL"
        }
      }
    },
    {
      "name": "Moeda inválida",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('404',()=>pm.response.to.have.status(404));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/latest?base=XXX&symbols=BRL"
        }
      }
    }
  ]
}